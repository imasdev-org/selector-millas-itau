#!/bin/sh
# Antes de cada commit le pone una versión nueva (?v=fecha-hora) a los archivos que carga index.html (y la plantilla),
# para que GitHub Pages no sirva versiones viejas desde la caché del navegador. Se activa una vez por clon:
#   git config core.hooksPath .githooks
node herramientas/subir-version.js >/dev/null 2>&1 && git add index.html
node plantilla/herramientas/subir-version.js >/dev/null 2>&1 && git add plantilla/index.html
exit 0
